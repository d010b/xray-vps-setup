services:
  angie:
    image: docker.angie.software/angie:minimal
    container_name: angie
    restart: always
    network_mode: host
    volumes:
      - angie-data:/var/lib/angie
      - ./angie.conf:/etc/angie/angie.conf:ro
      - ./index.html:/tmp/index.html:ro
      - /etc/angie/.htpasswd:/etc/angie/.htpasswd:ro 
  marzban:
    image: gozargah/marzban:latest
    container_name: marzban
    restart: always
    env_file: ./marzban/.env
    network_mode: host
    volumes:
      - ./marzban/xray_config.json:/code/xray_config.json:ro
      - ./xray-core:/var/lib/marzban/xray-core:ro
      - ./xray-core/geoip.dat:/usr/local/share/xray/geoip.dat:ro
      - ./xray-core/geosite.dat:/usr/local/share/xray/geosite.dat:ro
      - ./marzban_lib:/var/lib/marzban
      - ./marzban/templates:/var/lib/marzban/templates:ro
    depends_on:
      - angie

volumes:
  angie-data:
    driver: local
    external: false
    name: angie-data
  marzban_lib:
    driver: local
    external: false
    name: marzban_lib
