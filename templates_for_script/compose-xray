services:
  angie:
    image: docker.angie.software/angie:minimal
    container_name: angie
    restart: always
    network_mode: host
    volumes:
      - angie-data:/var/lib/angie
      - ./angie.conf:/etc/angie/angie.conf
      - ./index.html:/tmp/index.html
      - /etc/angie/.htpasswd:/etc/angie/.htpasswd:ro 
  xray:
    image: ghcr.io/xtls/xray-core:latest
    container_name: xray
    restart: always
    network_mode: host
    user: root
    volumes:
      - ./xray/config.json:/etc/xray/config.json:ro
      - ./xray/geoip.dat:/usr/local/share/xray/geoip.dat:ro
      - ./xray/geosite.dat:/usr/local/share/xray/geosite.dat:ro
    entrypoint: ["xray", "-config", "/etc/xray/config.json"]

volumes:
  angie-data:
    driver: local
    external: false
    name: angie-data
